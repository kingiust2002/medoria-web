# Copy this file to deploy/.env on the server.
# Never commit deploy/.env. Do not paste real secret values into chat or GitHub.

# Reverse proxy / TLS
ACME_EMAIL=admin@example.com

# Public values inlined during next build. The hostname must be one Caddy
# actually routes to the app -- see the site block in deploy/Caddyfile.
NEXT_PUBLIC_SITE_URL=https://staging.example.com
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
# Contact addresses. Health and Beauty show their own on their own pages and the
# gateway shows the _INFO one; any left empty falls back to NEXT_PUBLIC_EMAIL.
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_EMAIL_HEALTH=
NEXT_PUBLIC_EMAIL_BEAUTY=
NEXT_PUBLIC_EMAIL_INFO=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_TG_USERNAME=
NEXT_PUBLIC_WA_NUMBER=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_YANDEX_METRICA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Server-only Supabase credential
SUPABASE_SERVICE_ROLE_KEY=replace-on-server

# Health operator panel
OPERATOR_USERNAME=replace-on-server
OPERATOR_PASSWORD_HASH=replace-on-server
OPERATOR_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Beauty operator panel
BEAUTY_OPERATOR_USERNAME=replace-on-server
BEAUTY_OPERATOR_PASSWORD_HASH=replace-on-server
BEAUTY_OPERATOR_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Public-form protection
CAPTCHA_SECRET=replace-on-server

# Current external Redis rate limiter. This remains during app-only staging and
# will be replaced by self-hosted Valkey/Redis in a later migration phase.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional AI / translation integrations. Leave blank when unused.
# The website assistant answers with the first provider that has a key: Gemini, then Hugging Face, then Anthropic.
# With none set the chat widget offers WhatsApp/Telegram only (docs/CHATBOT.md).
# Gemini: free key from https://aistudio.google.com/apikey . Leave GEMINI_MODEL empty (the app tries the current
# Flash models and skips any that Google no longer serves); set it only to force a model, e.g. gemini-3.5-flash-lite
# (several names separated by commas are tried in order). Test the key on the server with:
#   node scripts/check-chat-provider.mjs --file=deploy/.env
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
HUGGING_FACE_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# Optional: Telegram notice for every new customer inquiry, one PRIVATE group per house.
# One bot (create it with @BotFather) serves both: add it to a Health group and a
# Beauty group, then put the bot token and the two groups' chat ids here and recreate
# the app container (docs/QUOTE_NOTIFICATIONS.md). Health inquiries go to the Health
# group, Beauty inquiries to the Beauty group. A house with an empty chat id sends
# nothing; leave everything empty to keep the feature off. The notice carries no phone
# number and no message text unless TELEGRAM_INCLUDE_DETAILS=true.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_HEALTH=
TELEGRAM_CHAT_ID_BEAUTY=
# Optional: a separate bot per house (each overrides TELEGRAM_BOT_TOKEN for its house)
TELEGRAM_BOT_TOKEN_HEALTH=
TELEGRAM_BOT_TOKEN_BEAUTY=
TELEGRAM_INCLUDE_DETAILS=
