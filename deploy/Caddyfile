{
  admin off
  email {$ACME_EMAIL}
}

api-staging.medoriaco.com, api.medoriaco.com {
  encode zstd gzip

  @supabase_api path /rest/v1 /rest/v1/* /auth/v1 /auth/v1/* /storage/v1 /storage/v1/*

  handle @supabase_api {
    reverse_proxy supabase-envoy:8000 {
      header_up X-Real-IP {remote_host}
    }
  }

  handle {
    respond "Not Found" 404
  }

  header {
    -Server
  }

  log {
    output stdout
    format json
  }
}

staging.medoriaco.com, medoriaco.com, www.medoriaco.com {
  encode zstd gzip

  reverse_proxy app:3000 {
    header_up X-Real-IP {remote_host}
  }

  header {
    -Server
  }

  log {
    output stdout
    format json
  }
}

# Owned secondary domain: send every request to the canonical site. medoria.co is
# NOT a canonical host (CLAUDE.md) -- it only forwards, permanently, keeping path+query.
medoria.co, www.medoria.co {
  redir https://medoriaco.com{uri} 308

  header {
    -Server
  }

  log {
    output stdout
    format json
  }
}
